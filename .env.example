# ===============================================================
# MYSTERY BOX ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env.local for local execution
# ===============================================================

# 1. Supabase Database & Storage Connection (Server-Only, never expose with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. Secret Mystery Box Code Hashes (scrypt with N=32768, r=8, p=1, keylen=32, base64url)
# Generate using: npm run hash:code
CODE_SALT=example_salt_generated_by_script
CODE_HASH=example_hash_generated_by_script

# 3. Admin Portal Password Hash (salt:hash derived from scripts/hash-admin-password.mjs)
# Generate using: npm run hash:admin
ADMIN_PASSWORD_HASH=example_admin_salt:example_admin_hash

# 4. Session JWT Secret (Minimum 32 characters, used for HS256 JWT signatures)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=a_very_secure_and_long_random_hex_string_32bytes_minimum

# 5. Site Origin (Enforced on mutating POST endpoints for CSRF protection)
SITE_ORIGIN=http://localhost:3000

# 6. Event Branding & Metadata
EVENT_NAME=Mystery Box
TEAM_NAME=The Code Guild & Forensics Lab
COLLEGE_NAME=Department of Computer Science & Engineering

# 7. Case Archive Delivery (Mode A: Supabase Storage bucket; Mode B: External download link)
# Mode A: Object path inside the private 'case-files' Supabase bucket
CASE_OBJECT_PATH=mystery-case-archive.zip
# Mode B: (Optional) External download link e.g. OneDrive / Google Drive
# CASE_ZIP_EXTERNAL_URL=https://drive.google.com/uc?export=download&id=...

# 8. Checkpoints (Optional JSON array of intermediate stage hashes for tie-breakers)
# CHECKPOINTS_JSON=[{"stageId":"stage1","salt":"...","hash":"..."}]
